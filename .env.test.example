# Dedicated Isolated Test Database Configuration
# WARNING: DB-backed tests execute deleteMany operations on database tables.
# Tests will REFUSE to run against the standard DEV or PROD database.
# Create a dedicated branch in Neon named "test" and populate connection strings here.

TEST_DATABASE_URL=postgresql://user:password@ep-sample-test-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
TEST_DIRECT_URL=postgresql://user:password@ep-sample-test.us-east-2.aws.neon.tech/neondb?sslmode=require

# Required substring marker that MUST be present in TEST_DATABASE_URL host or database name
TEST_DB_MARKER=test
