# Database URLs (Neon Postgres)
# DATABASE_URL uses pooled connection (pgbouncer) for runtime/serverless
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/invenaro_control?sslmode=require&pgbouncer=true"
# DIRECT_URL uses direct connection for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/invenaro_control?sslmode=require"

# License Signing Keys (Ed25519)
# Generate with: npm run keygen
LICENSE_SIGNING_KID="invenaro_key_2026_01"
LICENSE_SIGNING_PRIVATE_KEY="<base64-encoded-pkcs8-pem-private-key>"
LICENSE_PUBLIC_KEY="<base64-encoded-spki-pem-public-key>"

# Optional JSON array of previous public keys for JWKS rotation
# LICENSE_PUBLIC_JWKS='[{"kid":"old_key_id","kty":"OKP","crv":"Ed25519","x":"..."}]'

# Server & Verification Configuration
PORT=3000
TOKEN_TTL_HOURS=48
RATE_LIMIT_PER_HOUR=60
ALLOW_LOCALHOST=false
